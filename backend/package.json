{
    "name": "backend",
    "version": "1.0.0",
    "description": "Cashtrack API",
    "license": "ISC",
    "author": "",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "dev": "tsx --inspect=0.0.0.0:9229 --watch src/main.ts",
        "start": "node dist/main.js",
        "build": "tsc",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "migrate:dev": "prisma migrate dev",
        "migrate:deploy": "prisma migrate deploy",
        "prisma:generate": "prisma generate",
        "test": "vitest run --no-file-parallelism",
        "test:integration:migrate": "dotenv -o -e .env.test -- prisma migrate deploy",
        "test:integration:run": "dotenv -o -e .env.test -- vitest run --no-file-parallelism",
        "test:integration": "npm run test:integration:migrate && npm run test:integration:run"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@types/jest": "^30.0.0",
        "@types/supertest": "^7.2.1",
        "bcrypt": "^6.0.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "supertest": "^7.3.1",
        "vitest": "^5.0.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.20.2",
        "@types/pg": "^8.23.1",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "jiti": "^2.7.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.10.0",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0"
    }
}
